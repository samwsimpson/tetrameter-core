{
  "name": "@kumokodo/tetrameter-sdk",
  "version": "0.2.3",
  "description": "Metadata-only collector for Tetrameter. Records LLM call metadata — never prompt content — and groups multi-call agent runs into traces.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "default": "./dist/register.js"
    }
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build"
  },
  "sideEffects": false,
  "devDependencies": {
    "@kumokodo/tetrameter-core": "workspace:*"
  },
  "peerDependencies": {
    "@kumokodo/tetrameter-core": "*"
  },
  "peerDependenciesMeta": {
    "@kumokodo/tetrameter-core": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwsimpson/tetrameter-core.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://tetrameter.ai",
  "bugs": {
    "url": "https://github.com/samwsimpson/tetrameter-core/issues"
  }
}
