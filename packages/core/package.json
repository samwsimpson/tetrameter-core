{
  "name": "@kumokodo/tetrameter-core",
  "version": "0.1.0",
  "description": "Tetrameter — four measures of AI inference: energy, carbon, water and land, plus cost. Reference implementation of the Green Software Foundation SCI for AI specification. Every number carries an evidence tier, an uncertainty range and its sources.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "pnpm build",
    "prepack": "pnpm build"
  },
  "keywords": [
    "sci",
    "carbon",
    "llm",
    "sustainability",
    "ghg-protocol",
    "green-software"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/samwsimpson/tetrameter-core.git",
    "directory": "packages/core"
  },
  "homepage": "https://tetrameter.ai",
  "bugs": {
    "url": "https://github.com/samwsimpson/tetrameter-core/issues"
  }
}
